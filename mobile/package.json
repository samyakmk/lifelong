{
  "name": "baseline-lab-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo start --localhost --port 8084",
